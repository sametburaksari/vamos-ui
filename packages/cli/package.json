{
  "name": "vamos-ui",
  "version": "0.5.0",
  "description": "Add Vamos UI components, blocks and themes to your project.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://ui.vamos.ist",
  "keywords": [
    "vamos-ui",
    "design-system",
    "components",
    "tailwindcss",
    "react",
    "cli"
  ],
  "bin": {
    "vamos-ui": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js",
      "default": "./dist/verify.js"
    },
    "./brand": {
      "types": "./dist/brand.d.ts",
      "import": "./dist/brand.js",
      "default": "./dist/brand.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js",
      "default": "./dist/audit.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js",
      "default": "./dist/preset.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/verify.d.ts",
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "diff": "^9.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sametburaksari/vamos-ui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/sametburaksari/vamos-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
