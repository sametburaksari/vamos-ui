// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`brandCss > matches the snapshot 1`] = `
"/* vamos-ui brand: Lumen
 * Generated by \`vamos-ui brand apply\` from vamos.brand.json. Edit the JSON and re-run
 * instead of editing this file. Use: <html data-accent="brand" data-font="brand">
 */

[data-accent="brand"] {
  --accent-base: oklch(0.511 0.23 277); /* source #4f46e5 */
  --accent-fg: #fff; /* 6.27:1 on the fill */
  --accent-ink-light: oklch(0.511 0.23 277); /* 5.46:1 on light surfaces */
  --accent-ink-dark: oklch(0.7 0.158 277); /* 6.11:1 on dark surfaces */
  --radius: 20px;
  --scene: oklch(0.95 0.014 277);
}
[data-accent="brand"][data-density="compact"],
[data-accent="brand"] [data-density="compact"] {
  --radius: 14px;
}
.dark[data-accent="brand"],
.dark [data-accent="brand"] {
  --scene: oklch(0.165 0.01 277);
}
.dark .light[data-accent="brand"],
.dark .light [data-accent="brand"] {
  --scene: oklch(0.95 0.014 277);
}

[data-font="brand"] {
  --font-ui: var(--ff-brand-body, "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif);
  --font-heading: var(--ff-brand-display, "Sora", ui-sans-serif, system-ui, sans-serif);
  --font-code: var(--ff-brand-mono, "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace);
  --display-weight: 620;
  --display-tracking: -0.035em;
  --display-em: normal;
  --display-scale: 0.84;
}
"
`;
