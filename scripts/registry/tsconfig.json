{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["../../apps/www/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["*.mjs", "../build-registry.mjs"]
}
